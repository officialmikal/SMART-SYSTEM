# --- API CONFIGURATION (Vite) ---
# For Netlify Proxy (Current Setup): Use /api 
# For Local Dev: Use http://localhost:3000/api
# For Custom Domain: Use https://api.yourschool.com/api
# IMPORTANT: Always include the /api prefix as it matches the backend route structure.
VITE_API_URL=/api

# --- BACKEND CONFIGURATION ---
NODE_ENV=development
PORT=10000
JWT_SECRET=your_jwt_secret_min_32_chars
FRONTEND_URL=https://schoolname.netlify.app

# --- DATABASE CONFIGURATION ---
# The system supports both PostgreSQL (Prod) and SQLite (Local)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# --- KENYA SPECIFIC INTEGRATIONS ---
# M-Pesa Daraja API
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Africa's Talking SMS Gateway
AT_USERNAME=
AT_API_KEY=
